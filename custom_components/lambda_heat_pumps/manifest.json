{
  "domain": "lambda_heat_pumps",
  "name": "Lambda Heat Pumps",
  "after_dependencies": [
    "frontend",
    "http",
    "lovelace",
    "recorder",
    "repairs"
  ],
  "codeowners": [
    "@grexha"
  ],
  "config_flow": true,
  "dhcp": [
    {
      "macaddress": "0050F4*"
    },
    {
      "registered_devices": true
    }
  ],
  "documentation": "https://grexha.github.io/lambda_heat_pumps/",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/grexha/lambda_heat_pumps/issues",
  "loggers": [
    "modbus_connection",
    "tmodbus"
  ],
  "requirements": [
    "modbus-connection[tmodbus]>=4.8.1",
    "tmodbus>=0.6.1"
  ],
  "version": "3.7.1"
}
